{
	"name": "minni",
	"version": "0.1.0",
	"description": "Persistent structured memory plugin for OpenCode AI agents",
	"license": "MIT",
	"author": "Ozmah",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ozmah/minni"
	},
	"scripts": {
		"db:setup:opencode": "bun run scripts/setup-opencode-db.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"glados": "bun run lint && bun run fmt:check && bunx tsc --noEmit && cd viewer && bunx tsc --noEmit && bun run build",
		"sync": "rsync -av --delete --exclude='viewer/node_modules' --exclude='viewer/.git' --include='minni.ts' --include='src/***' --include='scripts/***' --include='migrations/***' --include='viewer/***' --include='drizzle.config.ts' --include='package.json' --include='tsconfig.json' --exclude='*' ./ ~/.config/opencode/plugins/minni/",
		"postinstall": "node scripts/postinstall.js",
		"prepare": "husky"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.1",
		"@elysiajs/eden": "^1.4.8",
		"@elysiajs/static": "^1.4.7",
		"@libsql/client": "^0.17.2",
		"@opencode-ai/plugin": "1.1.42",
		"@tursodatabase/database": "^0.4.4",
		"better-result": "^2.7.0",
		"drizzle-orm": "1.0.0-beta.22",
		"elysia": "^1.4.26",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"bun-types": "^1.3.10",
		"drizzle-kit": "1.0.0-beta.22",
		"husky": "^9.1.7",
		"oxfmt": "^0.27.0",
		"oxlint": "^1.50.0"
	}
}
